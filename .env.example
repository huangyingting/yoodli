# Local Development (SQLite)
DATABASE_URL="file:./dev.db"
DB_PROVIDER="sqlite"

# Production Deployment (PostgreSQL)
# Run `npm run db:use:postgres` before building for production Postgres
# DATABASE_URL="postgresql://postgres:password@localhost:5432/yoodli?schema=public"
# DB_PROVIDER="postgresql"

# NextAuth v5 & Account Admission Configuration
AUTH_SECRET="replace-with-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ACCOUNT_ADMISSION_MODE="invitation-only"

# Optional Live OpenAI / SSO Keys
# OPENAI_API_KEY="sk-..."
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
